# RCPU Mainnet Configuration Template
# Place this file at ~/.rcpu/rcpu.conf

# Network
server=1
txindex=0
port=7227

# RPC
# With server=1 the node creates a random auth cookie at ~/.rcpu/rcpu/.cookie;
# rcpu-cli reads it automatically. A static rpcuser/rpcpassword is optional:
#   rpcuser=YOUR_RPC_USER
#   rpcpassword=YOUR_STRONG_PASSWORD
rpcbind=127.0.0.1
rpcport=7337

# Logging
logips=1
listen=1

# Peers
# Seeds mirror the compiled list in src/chainparamsseeds.h
# (2 DNS + 5 IPs; keep in sync with docs/nodes/README.md and
# share/examples/rcpu.conf).
addnode=seed1.rcpu.top:7227
addnode=seed2.rcpu.top:7227
addnode=207.57.129.188:7227
addnode=38.147.171.29:7227
addnode=43.159.51.23:7227
addnode=38.55.199.177:7227
addnode=119.28.152.245:7227

# Memory / performance
dbcache=2048
maxconnections=64